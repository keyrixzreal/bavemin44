                listening = true
                keyBtn.Text = "..."
                keyBtn.TextColor3 = Theme.Error
            end)

            UserInputService.InputBegan:Connect(function(input, gpe)
                if listening and input.UserInputType == Enum.UserInputType.Keyboard then
                    obj.Value = input.KeyCode
                    keyBtn.Text = input.KeyCode.Name
                    keyBtn.TextColor3 = Theme.Accent
                    listening = false
                    if flag then window.Flags[flag] = input.KeyCode end
                    if cfg.Callback then pcall(cfg.Callback, input.KeyCode) end
                elseif not gpe and input.KeyCode == obj.Value and not listening then
                    if cfg.OnPressed then pcall(cfg.OnPressed) end
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if not listening and input.KeyCode == obj.Value then
