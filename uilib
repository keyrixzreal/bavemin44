        -- ==================== SLIDER ====================
        function tab:CreateSlider(cfg)
            cfg = cfg or {}
            local slider = { Value = cfg.Default or cfg.Min or 0 }
            local flag = cfg.Flag
            local min = cfg.Min or 0
            local max = cfg.Max or 100

            local frame = Create("Frame", {
                Parent = page,
                BackgroundColor3 = Config.Theme.Secondary,
                BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, 56),
            })
            Corner(frame, 8)
            Stroke(frame, Config.Theme.Stroke, 1)

            local hasIcon = cfg.Icon ~= nil
            local textOffset = hasIcon and 40 or 12

            if hasIcon then
                local iconBox = Create("Frame", {
                    Parent = frame,
                    BackgroundColor3 = Config.Theme.Tertiary,
                    BorderSizePixel = 0,
                    Size = UDim2.new(0, 24, 0, 24),
                    Position = UDim2.new(0, 8, 0, 6),
                })
                Corner(iconBox, 6)
                MakeIcon(iconBox, cfg.Icon, UDim2.new(0, 14, 0, 14),
                    UDim2.new(0.5, -7, 0.5, -7), Config.Theme.Accent, 2)
            end

            Create("TextLabel", {
                Parent = frame,
                BackgroundTransparency = 1,
                Text = cfg.Name or "Slider",
                Font = Config.Font,
                TextColor3 = Config.Theme.Text,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                Position = UDim2.new(0, textOffset, 0, 6),
                Size = UDim2.new(0.7, -textOffset, 0, 18),
            })

            local valueLabel = Create("TextLabel", {
                Parent = frame,
                BackgroundTransparency = 1,
                Text = tostring(slider.Value),
                Font = Config.FontBold,
                TextColor3 = Config.Theme.Accent,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Right,
                Position = UDim2.new(1, -60, 0, 6),
                Size = UDim2.new(0, 48, 0, 18),
            })

            local sliderBg = Create("Frame", {
                Parent = frame,
                BackgroundColor3 = Config.Theme.Tertiary,
                BorderSizePixel = 0,
                Size = UDim2.new(1, -24, 0, 8),
                Position = UDim2.new(0, 12, 0, 34),
            })
            Corner(sliderBg, 4)

            local fill = Create("Frame", {
                Parent = sliderBg,
                BackgroundColor3 = Config.Theme.Accent,
                BorderSizePixel = 0,
                Size = UDim2.new((slider.Value - min) / (max - min), 0, 1, 0),
            })
            Corner(fill, 4)

            local knob = Create("Frame", {
                Parent = sliderBg,
                BackgroundColor3 = Config.Theme.Text,
                BorderSizePixel = 0,
                Size = UDim2.new(0, 14, 0, 14),
                Position = UDim2.new((slider.Value - min) / (max - min), -7, 0.5, -7),
            })
            Corner(knob, 7)

            local dragging = false

            local function update(input)
                local pos = math.clamp((input.Position.X - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
                local val = math.floor(min + (max - min) * pos + 0.5)
                if cfg.Rounding then val = math.floor(val / cfg.Rounding) * cfg.Rounding end
                slider.Value = val
                valueLabel.Text = tostring(val)
                Tween(fill, 0.05, { Size = UDim2.new(pos, 0, 1, 0) })
                Tween(knob, 0.05, { Position = UDim2.new(pos, -7, 0.5, -7) })
                if flag then window.Flags[flag] = val end
                if cfg.Callback then pcall(cfg.Callback, val) end
            end

            sliderBg.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    update(input)
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch) then
                    update(input)
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)

            slider.Set = function(_, v)
                v = math.clamp(v, min, max)
                local pos = (v - min) / (max - min)
                slider.Value = v
                valueLabel.Text = tostring(v)
                Tween(fill, 0.1, { Size = UDim2.new(pos, 0, 1, 0) })
                Tween(knob, 0.1, { Position = UDim2.new(pos, -7, 0.5, -7) })
                if flag then window.Flags[flag] = v end
                if cfg.Callback then pcall(cfg.Callback, v) end
            end

            return slider
        end

