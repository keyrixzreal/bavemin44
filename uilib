            Parent = tabContainer,
            BackgroundColor3 = Config.Theme.Secondary,
            BorderSizePixel = 0,
            Text = "",
            Size = UDim2.new(1, 0, 0, 34),
            AutoButtonColor = false,
            LayoutOrder = #window.Tabs,
        })
        Corner(btn, 8)

        local tabIcon = MakeIcon(btn, icon, UDim2.new(0, 16, 0, 16),
            UDim2.new(0, 10, 0.5, -8), Config.Theme.SubText, 2)

        local textXOffset = tabIcon and 32 or 12
        local tabText = Create("TextLabel", {
            Parent = btn,
            BackgroundTransparency = 1,
            Text = name,
            Font = Config.Font,
            TextColor3 = Config.Theme.SubText,
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
            Position = UDim2.new(0, textXOffset, 0, 0),
            Size = UDim2.new(1, -textXOffset - 4, 1, 0),
            ZIndex = 2,
        })

        -- Content Page
        local page = Create("ScrollingFrame", {
            Parent = contentContainer,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 1, 0),
            CanvasSize = UDim2.new(0, 0, 0, 0),
            ScrollBarThickness = 4,
            ScrollBarImageColor3 = Config.Theme.Accent,
            BorderSizePixel = 0,
            Visible = false,
            ZIndex = 3,
        })
        Create("UIListLayout", {
            Parent = page,
            Padding = UDim.new(0, 8),
            SortOrder = Enum.SortOrder.LayoutOrder,
        })
        Create("UIPadding", { Parent = page, PaddingRight = UDim.new(0, 8) })

        local function updateCanvas()
            local layout = page:FindFirstChildOfClass("UIListLayout")
            page.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10)
        end
        page.ChildAdded:Connect(function() task.wait(); updateCanvas() end)
        page.ChildRemoved:Connect(function() task.wait(); updateCanvas() end)

        tab.Button = btn
        tab.Page = page
        tab.Icon = tabIcon

        -- Tab switching
        local function selectTab()
            for _, t in pairs(window.Tabs) do
                t.Button.BackgroundColor3 = Config.Theme.Secondary
                t.Button:FindFirstChildOfClass("TextLabel").TextColor3 = Config.Theme.SubText
                if t.Icon then t.Icon.ImageColor3 = Config.Theme.SubText end
                t.Page.Visible = false
            end
            Tween(btn, 0.15, { BackgroundColor3 = Config.Theme.Accent })
            tabText.TextColor3 = Color3.new(1, 1, 1)
            if tabIcon then Tween(tabIcon, 0.15, { ImageColor3 = Color3.new(1,1,1) }) end
            page.Visible = true
        end

        btn.MouseButton1Click:Connect(selectTab)
        btn.MouseEnter:Connect(function()
            if not page.Visible then
                Tween(btn, 0.15, { BackgroundColor3 = Config.Theme.Tertiary })
            end
        end)
        btn.MouseLeave:Connect(function()
            if not page.Visible then
                Tween(btn, 0.15, { BackgroundColor3 = Config.Theme.Secondary })
            end
        end)

        table.insert(window.Tabs, tab)
        if #window.Tabs == 1 then selectTab() end

