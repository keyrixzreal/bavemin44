        Parent = sidebar,
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 2, 0, 0),
        Position = UDim2.new(1, -1, 0, 0),
        Name = "ActiveIndicator",
    })

    local sidebarList = Create("Frame", {
        Parent = sidebar,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        Position = UDim2.new(0, 0, 0, 0),
    })
    Create("UIListLayout", {
        Parent = sidebarList,
        Padding = UDim.new(0, 2),
        SortOrder = Enum.SortOrder.LayoutOrder,
    })
    Pad(sidebarList, 8, 8, 8, 8)

    -- Content
    local content = Create("Frame", {
        Parent = bodyHolder,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -150, 1, 0),
        Position = UDim2.new(0, 150, 0, 0),
    })

    window.ScreenGui = screen
    window.Main = main
    window.Sidebar = sidebarList
    window.Content = content

    -- Fade-in animation
    main.Size = UDim2.new(0, 0, 0, 0)
    main.Position = UDim2.new(0.5, 0, 0.5, 0)
    task.defer(function()
        Tween(main, 0.3, {
            Size = UDim2.new(0, 620, 0, 420),
            Position = UDim2.new(0.5, -310, 0.5, -210),
        }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    end)

    -- ==================== CREATE TAB ====================
    function window:CreateTab(name, icon)
        local tab = {}

        local btn = Create("TextButton", {
            Parent = sidebarList,
            BackgroundColor3 = Theme.FrameBg,
            BorderSizePixel = 0,
            Text = "",
            Size = UDim2.new(1, 0, 0, 30),
            AutoButtonColor = false,
            LayoutOrder = #window.Tabs,
        })
        Corner(btn, 2)

        local btnIcon = MakeIcon(btn, icon, UDim2.new(0, 14, 0, 14),
            UDim2.new(0, 10, 0.5, -7), Theme.TextDisabled)

        local textX = btnIcon and 32 or 12
        local tabText = Create("TextLabel", {
            Parent = btn,
            BackgroundTransparency = 1,
            Text = name,
            Font = Enum.Font.Gotham,
            TextColor3 = Theme.TextDisabled,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            Position = UDim2.new(0, textX, 0, 0),
            Size = UDim2.new(1, -textX - 4, 1, 0),
            ZIndex = 2,
        })

        -- Left active bar
        local activeBar = Create("Frame", {
            Parent = btn,
            BackgroundColor3 = Theme.Accent,
            BorderSizePixel = 0,
            Size = UDim2.new(0, 2, 0, 0),
            Position = UDim2.new(0, 0, 0.5, 0),
            ZIndex = 3,
        })

        -- Content page
        local page = Create("ScrollingFrame", {
            Parent = content,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, -16, 1, -16),
            Position = UDim2.new(0, 8, 0, 8),
            CanvasSize = UDim2.new(0, 0, 0, 0),
            ScrollBarThickness = 4,
            ScrollBarImageColor3 = Theme.ScrollGrab,
            BorderSizePixel = 0,
            Visible = false,
        })
        Create("UIListLayout", {
            Parent = page,
            Padding = UDim.new(0, 6),
            SortOrder = Enum.SortOrder.LayoutOrder,
        })

        local function updateCanvas()
            local layout = page:FindFirstChildOfClass("UIListLayout")
            if layout then
                page.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 8)
            end
        end
        page.ChildAdded:Connect(function() task.wait(); updateCanvas() end)
        page.ChildRemoved:Connect(function() task.wait(); updateCanvas() end)

        tab.Button = btn
        tab.Page = page
        tab.Text = tabText
        tab.Icon = btnIcon
        tab.ActiveBar = activeBar

        local function selectTab()
            for _, t in pairs(window.Tabs) do
                Tween(t.Button, 0.12, { BackgroundColor3 = Theme.FrameBg })
                t.Text.TextColor3 = Theme.TextDisabled
                if t.Icon then t.Icon.ImageColor3 = Theme.TextDisabled end
                Tween(t.ActiveBar, 0.12, { Size = UDim2.new(0, 2, 0, 0) })
                t.Page.Visible = false
            end
            Tween(btn, 0.12, { BackgroundColor3 = Theme.FrameBgActive })
            tabText.TextColor3 = Theme.Text
            if btnIcon then Tween(btnIcon, 0.12, { ImageColor3 = Theme.Accent }) end
            Tween(activeBar, 0.2, { Size = UDim2.new(0, 2, 0, 18) })
            page.Visible = true
        end

        btn.MouseButton1Click:Connect(selectTab)
        btn.MouseEnter:Connect(function()
            if not page.Visible then
                Tween(btn, 0.1, { BackgroundColor3 = Theme.FrameBgHover })
                Tween(tabText, 0.1, { TextColor3 = Theme.Text })
            end
        end)
        btn.MouseLeave:Connect(function()
            if not page.Visible then
                Tween(btn, 0.1, { BackgroundColor3 = Theme.FrameBg })
                Tween(tabText, 0.1, { TextColor3 = Theme.TextDisabled })
            end
        end)

        table.insert(window.Tabs, tab)
        if #window.Tabs == 1 then selectTab() end

        -- ==================== SECTION ====================
        function tab:CreateSection(text)
            local holder = Create("Frame", {
                Parent = page,
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 22),
            })
            -- Left accent line
            Create("Frame", {
                Parent = holder,
                BackgroundColor3 = Theme.Accent,
                BorderSizePixel = 0,
                Size = UDim2.new(0, 2, 0, 12),
                Position = UDim2.new(0, 0, 0.5, -6),
            })
            Create("TextLabel", {
                Parent = holder,
                BackgroundTransparency = 1,
                Text = string.upper(text),
                Font = Enum.Font.GothamBold,
                TextColor3 = Theme.Text,
                TextSize = 11,
                TextXAlignment = Enum.TextXAlignment.Left,
                Position = UDim2.new(0, 10, 0, 0),
                Size = UDim2.new(1, -10, 1, 0),
            })
            -- Right divider
            Create("Frame", {
                Parent = holder,
                BackgroundColor3 = Theme.Border,
                BorderSizePixel = 0,
                Size = UDim2.new(0.6, 0, 0, 1),
                Position = UDim2.new(0.4, 0, 0.5, 0),
            })
            return holder
        end

        -- ==================== SEPARATOR ====================
        function tab:CreateSeparator()
            return Create("Frame", {
                Parent = page,
                BackgroundColor3 = Theme.Border,
                BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, 1),
            })
        end

        -- ==================== LABEL ====================
        function tab:CreateLabel(text, icon)
            local holder = Create("Frame", {
                Parent = page,
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 18),
            })
            local xOffset = 0
            if icon then
                MakeIcon(holder, icon, UDim2.new(0, 12, 0, 12),
                    UDim2.new(0, 0, 0.5, -6), Theme.TextDisabled)
                xOffset = 18
            end
            Create("TextLabel", {
                Parent = holder,
                BackgroundTransparency = 1,
                Text = text,
                Font = Enum.Font.Gotham,
                TextColor3 = Theme.TextDisabled,
                TextSize = 11,
                TextXAlignment = Enum.TextXAlignment.Left,
                Position = UDim2.new(0, xOffset, 0, 0),
                Size = UDim2.new(1, -xOffset, 1, 0),
            })
            return holder
        end

        -- ==================== BUTTON ====================
        function tab:CreateButton(cfg)
            cfg = cfg or {}
