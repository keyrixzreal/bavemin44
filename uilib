                Corner(iconBox, 6)
                MakeIcon(iconBox, cfg.Icon, UDim2.new(0, 14, 0, 14),
                    UDim2.new(0.5, -7, 0.5, -7), Config.Theme.Accent, 6)
            end

            Create("TextLabel", {
                Parent = frame,
                BackgroundTransparency = 1,
                Text = cfg.Name or "Dropdown",
                Font = Config.Font,
                TextColor3 = Config.Theme.Text,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                Position = UDim2.new(0, textOffset, 0, 0),
                Size = UDim2.new(0.5, -textOffset, 1, 0),
                ZIndex = 5,
            })

            local selectedLabel = Create("TextLabel", {
                Parent = frame,
                BackgroundTransparency = 1,
                Text = tostring(dropdown.Value or "Seçiniz"),
                Font = Config.Font,
                TextColor3 = Config.Theme.Accent,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Right,
                Position = UDim2.new(0.5, -30, 0, 0),
                Size = UDim2.new(0.5, -30, 1, 0),
                ZIndex = 5,
            })

            local arrow = MakeIcon(frame, "chevron-down", UDim2.new(0, 12, 0, 12),
                UDim2.new(1, -22, 0.5, -6), Config.Theme.SubText, 5)

            local list = Create("Frame", {
                Parent = holder,
                BackgroundColor3 = Config.Theme.Tertiary,
                BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, 0),
                Position = UDim2.new(0, 0, 1, 4),
                Visible = false,
                ZIndex = 10,
                ClipsDescendants = true,
            })
            Corner(list, 8)
            Stroke(list, Config.Theme.Stroke, 1)

            local listLayout = Create("UIListLayout", {
                Parent = list,
                Padding = UDim.new(0, 2),
                SortOrder = Enum.SortOrder.LayoutOrder,
            })
            Create("UIPadding", {
                Parent = list,
                PaddingTop = UDim.new(0, 4),
                PaddingBottom = UDim.new(0, 4),
            })

            local btn = Create("TextButton", {
                Parent = frame,
                BackgroundTransparency = 1,
                Text = "",
                Size = UDim2.new(1, 0, 1, 0),
                ZIndex = 6,
            })

            local function closeList()
                open = false
                Tween(list, 0.2, { Size = UDim2.new(1, 0, 0, 0) })
                if arrow then Tween(arrow, 0.2, { Rotation = 0 }) end
                task.wait(0.2)
                if not open then list.Visible = false end
            end

            for _, opt in ipairs(options) do
                local optBtn = Create("TextButton", {
                    Parent = list,
                    BackgroundColor3 = Config.Theme.Tertiary,
                    BorderSizePixel = 0,
                    Text = "  " .. tostring(opt),
                    Font = Config.Font,
                    TextColor3 = Config.Theme.Text,
                    TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Size = UDim2.new(1, 0, 0, 28),
                    AutoButtonColor = false,
                    ZIndex = 11,
                })
                Corner(optBtn, 6)

                optBtn.MouseEnter:Connect(function()
                    Tween(optBtn, 0.15, { BackgroundColor3 = Config.Theme.Accent })
                end)
                optBtn.MouseLeave:Connect(function()
                    Tween(optBtn, 0.15, { BackgroundColor3 = Config.Theme.Tertiary })
                end)
                optBtn.MouseButton1Click:Connect(function()
                    dropdown.Value = opt
                    selectedLabel.Text = tostring(opt)
                    if flag then window.Flags[flag] = opt end
                    if cfg.Callback then pcall(cfg.Callback, opt) end
                    closeList()
                end)
            end

            btn.MouseButton1Click:Connect(function()
                open = not open
                if open then
                    list.Visible = true
                    local target = listLayout.AbsoluteContentSize.Y + 8
                    Tween(list, 0.25, { Size = UDim2.new(1, 0, 0, target) })
                    if arrow then Tween(arrow, 0.2, { Rotation = 180 }) end
                else
                    closeList()
                end
            end)

            dropdown.Set = function(_, v)
                dropdown.Value = v
                selectedLabel.Text = tostring(v)
                if flag then window.Flags[flag] = v end
            end

            return dropdown
        end

        -- ==================== TEXTBOX ====================
        function tab:CreateTextBox(cfg)
            cfg = cfg or {}
            local textbox = { Value = cfg.Default or "" }
            local flag = cfg.Flag

            local frame = Create("Frame", {
                Parent = page,
                BackgroundColor3 = Config.Theme.Secondary,
                BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, 36),
            })
            Corner(frame, 8)
            Stroke(frame, Config.Theme.Stroke, 1)

            local hasIcon = cfg.Icon ~= nil
            local textOffset = hasIcon and 40 or 12

            if hasIcon then
                local iconBox = Create("Frame", {
                    Parent = frame,
                    BackgroundColor3 = Config.Theme.Tertiary,
                    BorderSizePixel = 0,
                    Size = UDim2.new(0, 24, 0, 24),
                    Position = UDim2.new(0, 8, 0.5, -12),
                })
                Corner(iconBox, 6)
                MakeIcon(iconBox, cfg.Icon, UDim2.new(0, 14, 0, 14),
                    UDim2.new(0.5, -7, 0.5, -7), Config.Theme.Accent, 2)
            end

            Create("TextLabel", {
                Parent = frame,
                BackgroundTransparency = 1,
                Text = cfg.Name or "Input",
                Font = Config.Font,
                TextColor3 = Config.Theme.Text,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                Position = UDim2.new(0, textOffset, 0, 0),
                Size = UDim2.new(0.4, -textOffset, 1, 0),
            })

            local input = Create("TextBox", {
                Parent = frame,
                BackgroundColor3 = Config.Theme.Tertiary,
                BorderSizePixel = 0,
                Text = cfg.Default or "",
                PlaceholderText = cfg.Placeholder or "Yaz...",
                PlaceholderColor3 = Config.Theme.SubText,
                Font = Config.Font,
                TextColor3 = Config.Theme.Text,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                Position = UDim2.new(0.5, -10, 0.5, -12),
                Size = UDim2.new(0.5, -2, 0, 24),
                ClearTextOnFocus = false,
            })
            Corner(input, 6)
            local inputStroke = Stroke(input, Config.Theme.Stroke, 1)
            Create("UIPadding", { Parent = input, PaddingLeft = UDim.new(0, 8) })

            input.Focused:Connect(function()
                Tween(input, 0.15, { BackgroundColor3 = Config.Theme.Background })
                Tween(inputStroke, 0.15, { Color = Config.Theme.Accent })
            end)
            input.FocusLost:Connect(function(enter)
                Tween(input, 0.15, { BackgroundColor3 = Config.Theme.Tertiary })
                Tween(inputStroke, 0.15, { Color = Config.Theme.Stroke })
                textbox.Value = input.Text
                if flag then window.Flags[flag] = input.Text end
                if cfg.Callback then pcall(cfg.Callback, input.Text, enter) end
            end)

            textbox.Set = function(_, v)
                input.Text = v
                textbox.Value = v
                if flag then window.Flags[flag] = v end
            end

            return textbox
        end

        -- ==================== KEYBIND ====================
        function tab:CreateKeybind(cfg)
            cfg = cfg or {}
            local keybind = { Value = cfg.Default or Enum.KeyCode.E }
            local flag = cfg.Flag
            local listening = false

            local frame = Create("Frame", {
                Parent = page,
                BackgroundColor3 = Config.Theme.Secondary,
                BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, 36),
            })
            Corner(frame, 8)
            Stroke(frame, Config.Theme.Stroke, 1)

            local hasIcon = cfg.Icon ~= nil
            local textOffset = hasIcon and 40 or 12

            if hasIcon then
                local iconBox = Create("Frame", {
                    Parent = frame,
                    BackgroundColor3 = Config.Theme.Tertiary,
                    BorderSizePixel = 0,
                    Size = UDim2.new(0, 24, 0, 24),
                    Position = UDim2.new(0, 8, 0.5, -12),
                })
                Corner(iconBox, 6)
                MakeIcon(iconBox, cfg.Icon, UDim2.new(0, 14, 0, 14),
                    UDim2.new(0.5, -7, 0.5, -7), Config.Theme.Accent, 2)
            end

            Create("TextLabel", {
                Parent = frame,
                BackgroundTransparency = 1,
                Text = cfg.Name or "Keybind",
                Font = Config.Font,
                TextColor3 = Config.Theme.Text,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                Position = UDim2.new(0, textOffset, 0, 0),
                Size = UDim2.new(0.6, -textOffset, 1, 0),
            })

            local keyBtn = Create("TextButton", {
                Parent = frame,
                BackgroundColor3 = Config.Theme.Tertiary,
                BorderSizePixel = 0,
                Text = keybind.Value.Name,
                Font = Config.FontBold,
                TextColor3 = Config.Theme.Accent,
                TextSize = 12,
                Size = UDim2.new(0, 80, 0, 24),
                Position = UDim2.new(1, -92, 0.5, -12),
                AutoButtonColor = false,
            })
            Corner(keyBtn, 6)
            Stroke(keyBtn, Config.Theme.Stroke, 1)

            keyBtn.MouseButton1Click:Connect(function()
                listening = true
                keyBtn.Text = "..."
                keyBtn.TextColor3 = Config.Theme.Danger
            end)

            UserInputService.InputBegan:Connect(function(input, gpe)
                if listening and input.UserInputType == Enum.UserInputType.Keyboard then
                    keybind.Value = input.KeyCode
                    keyBtn.Text = input.KeyCode.Name
                    keyBtn.TextColor3 = Config.Theme.Accent
                    listening = false
                    if flag then window.Flags[flag] = input.KeyCode end
                    if cfg.Callback then pcall(cfg.Callback, input.KeyCode) end
                elseif not gpe and input.KeyCode == keybind.Value and not listening then
                    if cfg.OnPressed then pcall(cfg.OnPressed) end
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if not listening and input.KeyCode == keybind.Value then
                    if cfg.OnReleased then pcall(cfg.OnReleased) end
                end
            end)

            return keybind
        end

        -- ==================== LABEL ====================
        function tab:CreateLabel(text, icon)
            local holder = Create("Frame", {
                Parent = page,
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 20),
            })
            local offset = 0
            if icon then
                MakeIcon(holder, icon, UDim2.new(0, 14, 0, 14),
                    UDim2.new(0, 0, 0.5, -7), Config.Theme.SubText, 2)
                offset = 20
            end
            Create("TextLabel", {
                Parent = holder,
                BackgroundTransparency = 1,
                Text = text,
                Font = Config.Font,
                TextColor3 = Config.Theme.SubText,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                Position = UDim2.new(0, offset, 0, 0),
                Size = UDim2.new(1, -offset, 1, 0),
            })
            return holder
        end

        -- ==================== DIVIDER ====================
        function tab:CreateDivider()
            return Create("Frame", {
                Parent = page,
                BackgroundColor3 = Config.Theme.Stroke,
                BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, 1),
            })
        end

        return tab
    end

    -- ==================== TOGGLE UI ====================
    function window:ToggleUI()
        main.Visible = not main.Visible
    end

    UserInputService.InputBegan:Connect(function(input, gpe)
        if not gpe and input.KeyCode == Enum.KeyCode.RightShift then
            window:ToggleUI()
        end
    end)

    return window
end

return Library
