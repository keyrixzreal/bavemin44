local notifOrder = 0
local notifMap = {}

function Library:Notify(cfg)
    cfg = cfg or {}
    ensureNotifGui()

    local nType = cfg.Type or "info"
    local accent = Theme.Info
    if nType == "success" then accent = Theme.Success
    elseif nType == "warning" then accent = Theme.Warning
    elseif nType == "error" then accent = Theme.Error end

    local duration = cfg.Duration or 4
    notifOrder = notifOrder + 1

    local holder = Create("Frame", {
        Parent = notifHolder,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, cfg.Height or 62),
        LayoutOrder = notifOrder,
    })

    local body = Create("Frame", {
        Parent = holder,
        BackgroundColor3 = Theme.ChildBg,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 1, 0),
        Position = UDim2.new(1, 40, 0, 0),  -- slide-in start
        BackgroundTransparency = 1,
    })
    Corner(body, 3)
    local stroke = Stroke(body, Theme.Border, 1)
    stroke.Transparency = 1

    -- Left accent bar
    local accentBar = Create("Frame", {
        Parent = body,
        BackgroundColor3 = accent,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 3, 1, 0),
    })
    Corner(accentBar, 3)

    -- Icon
    local iconUrl = cfg.Icon and GetIcon(cfg.Icon)
    if iconUrl then
        Create("ImageLabel", {
            Parent = body,
            BackgroundTransparency = 1,
            Image = iconUrl,
            ImageColor3 = accent,
            Size = UDim2.new(0, 16, 0, 16),
            Position = UDim2.new(0, 12, 0, 12),
        })
    end
    local textX = iconUrl and 36 or 14

    -- Title
    local titleLbl = Create("TextLabel", {
        Parent = body,
        BackgroundTransparency = 1,
        Text = cfg.Title or "Bildirim",
        Font = Enum.Font.GothamBold,
        TextColor3 = Theme.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Position = UDim2.new(0, textX, 0, 8),
        Size = UDim2.new(1, -textX - 30, 0, 16),
    })

    -- Message
    local msgLbl = Create("TextLabel", {
        Parent = body,
        BackgroundTransparency = 1,
        Text = cfg.Text or "",
        Font = Enum.Font.Gotham,
        TextColor3 = Theme.TextDisabled,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
        Position = UDim2.new(0, textX, 0, 26),
        Size = UDim2.new(1, -textX - 14, 0, 30),
    })

    -- Close X
    local closeBtn = Create("TextButton", {
        Parent = body,
        BackgroundTransparency = 1,
        Text = "✕",
        Font = Enum.Font.GothamBold,
        TextColor3 = Theme.TextDisabled,
        TextSize = 12,
        Size = UDim2.new(0, 20, 0, 20),
        Position = UDim2.new(1, -26, 0, 6),
        AutoButtonColor = false,
    })

    -- Progress bar
    local progBg = Create("Frame", {
        Parent = body,
        BackgroundColor3 = Theme.FrameBg,
        BorderSizePixel = 0,
        Size = UDim2.new(1, -6, 0, 2),
        Position = UDim2.new(0, 3, 1, -3),
    })
    local progFill = Create("Frame", {
        Parent = progBg,
        BackgroundColor3 = accent,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 1, 0),
    })

    -- Slide-in animation
    Tween(body, 0.35, { Position = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 0 },
        Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    Tween(stroke, 0.35, { Transparency = 0 })

    -- Progress tween
    local progTween = TweenService:Create(progFill,
        TweenInfo.new(duration, Enum.EasingStyle.Linear),
        { Size = UDim2.new(0, 0, 1, 0) })
    progTween:Play()

    local dismissed = false
    local function dismiss()
        if dismissed then return end
        dismissed = true
        progTween:Cancel()
        Tween(body, 0.25, {
            Position = UDim2.new(1, 40, 0, 0),
            BackgroundTransparency = 1,
        }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        Tween(stroke, 0.25, { Transparency = 1 })
        Tween(holder, 0.3, { Size = UDim2.new(1, 0, 0, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        task.wait(0.3)
        if holder and holder.Parent then holder:Destroy() end
    end

    closeBtn.MouseEnter:Connect(function()
        Tween(closeBtn, 0.1, { TextColor3 = Theme.Text })
    end)
    closeBtn.MouseLeave:Connect(function()
        Tween(closeBtn, 0.1, { TextColor3 = Theme.TextDisabled })
    end)
    closeBtn.MouseButton1Click:Connect(dismiss)

    task.spawn(function()
        task.wait(duration)
        dismiss()
    end)

    return { dismiss = dismiss }
end

