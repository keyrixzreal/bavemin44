        -- ==================== SLIDER (ImGui style) ====================
        function tab:CreateSlider(cfg)
            cfg = cfg or {}
            local obj = { Value = cfg.Default or cfg.Min or 0 }
            local flag = cfg.Flag
            local min = cfg.Min or 0
            local max = cfg.Max or 100

            local frame = Create("Frame", {
                Parent = page,
                BackgroundColor3 = Theme.FrameBg,
                BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, 46),
            })
            Corner(frame, 2)
            Stroke(frame, Theme.Border, 1)

            local hasIcon = cfg.Icon ~= nil
            local xOffset = hasIcon and 30 or 10

            if hasIcon then
                MakeIcon(frame, cfg.Icon, UDim2.new(0, 14, 0, 14),
                    UDim2.new(0, 10, 0, 8), Theme.Accent)
            end

            Create("TextLabel", {
                Parent = frame,
                BackgroundTransparency = 1,
                Text = cfg.Name or "Slider",
                Font = Enum.Font.Gotham,
                TextColor3 = Theme.Text,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                Position = UDim2.new(0, xOffset, 0, 6),
                Size = UDim2.new(0.7, -xOffset, 0, 16),
            })

            local valueLabel = Create("TextLabel", {
                Parent = frame,
                BackgroundTransparency = 1,
                Text = tostring(obj.Value),
                Font = Enum.Font.Code,
                TextColor3 = Theme.Accent,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Right,
                Position = UDim2.new(1, -58, 0, 6),
                Size = UDim2.new(0, 48, 0, 16),
            })

            -- Track
            local track = Create("Frame", {
                Parent = frame,
                BackgroundColor3 = Theme.FrameBgActive,
                BorderSizePixel = 0,
                Size = UDim2.new(1, -20, 0, 6),
                Position = UDim2.new(0, 10, 0, 30),
            })
            Corner(track, 2)

            local fill = Create("Frame", {
                Parent = track,
                BackgroundColor3 = Theme.Accent,
                BorderSizePixel = 0,
                Size = UDim2.new((obj.Value - min) / (max - min), 0, 1, 0),
            })
            Corner(fill, 2)

            local dragging = false
            local function update(input)
                local pos = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                local val = math.floor(min + (max - min) * pos + 0.5)
                if cfg.Rounding then val = math.floor(val / cfg.Rounding) * cfg.Rounding end
                obj.Value = val
                valueLabel.Text = tostring(val)
                Tween(fill, 0.05, { Size = UDim2.new(pos, 0, 1, 0) })
                if flag then window.Flags[flag] = val end
                if cfg.Callback then pcall(cfg.Callback, val) end
            end

            track.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    update(input)
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch) then
                    update(input)
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)

            obj.Set = function(_, v)
                v = math.clamp(v, min, max)
                local pos = (v - min) / (max - min)
                obj.Value = v
                valueLabel.Text = tostring(v)
                Tween(fill, 0.1, { Size = UDim2.new(pos, 0, 1, 0) })
                if flag then window.Flags[flag] = v end
                if cfg.Callback then pcall(cfg.Callback, v) end
            end

            return obj
        end

