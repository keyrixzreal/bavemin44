-- ==================== UTILS ====================
local function Create(class, props)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do inst[k] = v end
    return inst
end

local function Tween(obj, time, goal, style, dir)
    local t = TweenService:Create(obj,
        TweenInfo.new(time or 0.15, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
        goal)
    t:Play()
    return t
end

local function Corner(parent, r)
    return Create("UICorner", { CornerRadius = UDim.new(0, r or 2), Parent = parent })
end

local function Stroke(parent, c, t)
    return Create("UIStroke", {
        Color = c or Theme.Border,
        Thickness = t or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = parent,
    })
end

local function Pad(parent, t, b, l, r)
    return Create("UIPadding", {
        PaddingTop    = UDim.new(0, t or 0),
        PaddingBottom = UDim.new(0, b or 0),
        PaddingLeft   = UDim.new(0, l or 0),
        PaddingRight  = UDim.new(0, r or 0),
        Parent = parent,
    })
end

local function GetIcon(name)
    if not name then return nil end
    if type(name) == "number" then return "rbxassetid://" .. name end
    return Library.Icons[name] or name
end

local function MakeIcon(parent, name, size, pos, color, zIndex)
    local url = GetIcon(name)
    if not url then return nil end
    return Create("ImageLabel", {
        Parent = parent,
        BackgroundTransparency = 1,
        Image = url,
        ImageColor3 = color or Theme.TextDisabled,
        Size = size or UDim2.new(0, 14, 0, 14),
        Position = pos or UDim2.new(0, 0, 0.5, -7),
        ZIndex = zIndex or 2,
    })
end

local function Draggable(frame, dragArea)
    dragArea = dragArea or frame
    local dragging, dragInput, dragStart, startPos
    dragArea.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    dragArea.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local d = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y
            )
        end
    end)
end

